<!DOCTYPE html>
<html lang="{{ app.request.locale|default('sk') }}" data-bs-theme="dark">
<head>
    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-WT9258KFMR"></script>
    <script>
        window.dataLayer = window.dataLayer || [];
        function gtag(){dataLayer.push(arguments);}
        gtag('js', new Date());

        gtag('config', 'G-WT9258KFMR');
    </script>
    <meta charset="UTF-8">
    <script>
        // Tmavý/svetlý režim — téma je na <html>, beží v <head> pred vykreslením (bez bliknutia).
        // Turbo Drive je vypnuté (assets/controllers.json) — stránky stoja na jQuery a skriptoch, ktoré
        // počítajú s plným načítaním. Keby sa Turbo zaplo, téma prežije aj jeho navigáciu (turbo:* nižšie).
        (function () {
            if (window.hribikyTheme) { return; }
            function current() {
                var saved = null;
                try { saved = localStorage.getItem('theme'); } catch (e) {}
                return saved || (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
            }
            function apply(root) {
                var theme = current();
                document.documentElement.setAttribute('data-bs-theme', theme);
                var scope = root || document;
                var sun = scope.querySelector('#icon-sun'), moon = scope.querySelector('#icon-moon');
                // Zobraziť ikonku témy, na ktorú sa dá prepnúť.
                if (sun && moon) {
                    sun.classList.toggle('d-none', theme !== 'dark');
                    moon.classList.toggle('d-none', theme === 'dark');
                }
            }
            window.hribikyTheme = { apply: apply };
            apply();
            document.addEventListener('DOMContentLoaded', function () { apply(); });
            document.addEventListener('turbo:before-render', function (e) { apply(e.detail.newBody); });
            document.addEventListener('turbo:load', function () { apply(); });
            // Delegovaný klik — funguje aj na tlačidle v novom <body> po Turbo navigácii.
            document.addEventListener('click', function (e) {
                if (!e.target.closest('#themeToggle')) { return; }
                try { localStorage.setItem('theme', current() === 'dark' ? 'light' : 'dark'); } catch (err) {}
                apply();
            });
        })();
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="theme-color" content="#212529">
    <title>{% block title %}{{ 'site_name'|trans }}{% endblock %}</title>

    {# ---- SEO meta (prekrývateľné po stránkach) ---- #}
    {% block meta_description %}<meta name="description" content="{{ 'site_description'|trans }}">{% endblock %}
    {% block robots %}{% endblock %}
    {% block canonical %}<link rel="canonical" href="{{ app.request.schemeAndHttpHost ~ app.request.pathInfo }}"/>{% endblock %}
    {% block hreflang %}
    <link rel="alternate" hreflang="sk" href="https://hribiky.sk{{ app.request.pathInfo }}"/>
    <link rel="alternate" hreflang="cs" href="https://hribiky.cz{{ app.request.pathInfo }}"/>
    <link rel="alternate" hreflang="x-default" href="https://hribiky.sk{{ app.request.pathInfo }}"/>
    {% endblock %}

    {# ---- Open Graph ---- #}
    <meta property="og:site_name" content="{{ 'site_name'|trans }}"/>
    <meta property="og:locale" content="{{ app.request.locale == 'cs' ? 'cs_CZ' : 'sk_SK' }}"/>
    <meta property="og:title" content="{% block og_title %}{{ 'site_name'|trans }}{% endblock %}"/>
    <meta property="og:type" content="{% block og_type %}website{% endblock %}"/>
    <meta property="og:url" content="{% block og_url %}{{ app.request.schemeAndHttpHost ~ app.request.pathInfo }}{% endblock %}"/>
    <meta property="og:description" content="{% block og_description %}{{ 'site_description'|trans }}{% endblock %}"/>
    <meta property="og:image" content="{% block og_image %}{{ absolute_url(asset('images/android-chrome-512x512.png')) }}{% endblock %}"/>

    {# ---- Twitter Card ---- #}
    <meta name="twitter:card" content="summary_large_image"/>
    <meta name="twitter:title" content="{{ block('og_title') }}"/>
    <meta name="twitter:description" content="{{ block('og_description') }}"/>
    <meta name="twitter:image" content="{{ block('og_image') }}"/>
    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
        rel="stylesheet"
        integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH"
        crossorigin="anonymous">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" integrity="sha512-Avb2QiuDEEvB4bZJYdft2mNjVShBftLdPG8FJ0V7irTLQ8Uo0qcPxh4Plq7G5tGm0rU+1SPhVotteLpBERwTkw==" crossorigin="anonymous" referrerpolicy="no-referrer" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css"
          integrity="sha384-tViUnnbYAV00FLIhhi3v/dWt3Jxw4gZQcNoSCxCIFNJVCx7/D55/wXsrNIRANwdD" crossorigin="anonymous">
    <link rel="stylesheet" href="{{ asset('css/hribiky.css') }}">
    {% block stylesheets %}
    {% endblock %}

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Roboto+Slab:wght@100..900&display=swap" rel="stylesheet">
    {% block headscripts %}{% endblock %}
    {% block javascripts %}
        {% block importmap %}{{ importmap('app') }}{% endblock %}
    {% endblock %}
    <link rel="apple-touch-icon" sizes="180x180" href="/images/apple-touch-icon.png">
    <link rel="icon" type="image/png" sizes="32x32" href="/images/favicon-32x32.png">
    <link rel="icon" type="image/png" sizes="16x16" href="/images/favicon-16x16.png">
    <link rel="manifest" href="/images/site.webmanifest">
    <meta name="apple-itunes-app" content="app-id=6777217981">
    {% block ogtags %}{% endblock %}
</head>
<body data-locale="{{ app.request.locale }}">
<nav class="navbar navbar-expand-lg bg-body-tertiary" id="mainNavbar">
    <div class="container">
        <a class="navbar-brand" href="{{ path('app_home') }}">
            {% block navbarbrand %}{{ 'menu.mushrooms'|trans }}{% endblock %}
        </a>

        {% if app.request.attributes.get('_route') == 'app_home' %}
            <button class="btn btn-success" id="addRozcestnik">{{ 'mushroom.add_button'|trans }}</button>
        {% endif %}

        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarSupportedContent"
                aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
            <span class="navbar-toggler-icon"></span>
        </button>

        <div class="collapse navbar-collapse" id="navbarSupportedContent">
            <ul class="navbar-nav ms-auto mb-2 mb-lg-0">
                <li class="nav-item">
                    <a class="nav-link" href="{{ path('blog_index') }}"><i class="bi bi-newspaper"></i>&nbsp;Blog</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="{{ path('about') }}"><i class="bi bi-chat-heart-fill"></i>&nbsp;{{ 'about.title'|trans }}</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="{{ path('contact') }}"><i class="bi bi-envelope"></i>&nbsp;{{ 'contact'|trans }}</a>
                </li>
            </ul>

            {# Vyhľadávanie v hríbikoch a blogu #}
            <form class="d-flex ms-lg-3 my-2 my-lg-0 position-relative" role="search" action="{{ path('search') }}" method="get" id="navbarSearch"
                  data-suggest-url="{{ path('search_suggest') }}"
                  data-label-mushrooms="{{ 'search.mushrooms'|trans }}"
                  data-label-blog="{{ 'search.blog'|trans }}"
                  data-label-all="{{ 'search.show_all'|trans }}"
                  data-label-none="{{ 'search.suggest_none'|trans }}">
                <div class="input-group">
                    <input type="search" name="q" class="form-control" id="navbarSearchInput"
                           placeholder="{{ 'search.placeholder'|trans }}" aria-label="{{ 'search.placeholder'|trans }}"
                           value="{{ app.request.attributes.get('_route') == 'search' ? app.request.query.get('q') }}"
                           autocomplete="off" role="combobox" aria-autocomplete="list"
                           aria-expanded="false" aria-controls="navbarSearchSuggestions">
                    <button class="btn btn-outline-secondary" type="submit" aria-label="{{ 'search.submit'|trans }}">
                        <i class="bi bi-search"></i>
                    </button>
                </div>
                {# Návrhy (autocomplete) — plní public/js/search-autocomplete.js #}
                <div class="dropdown-menu w-100 shadow search-suggestions" id="navbarSearchSuggestions" role="listbox"
                     aria-label="{{ 'search.placeholder'|trans }}"></div>
            </form>

            {# Prepínač svetlý / tmavý režim #}
            <div class="ms-lg-3">
                <button id="themeToggle" class="btn btn-outline-secondary d-flex align-items-center" type="button">
                    <i class="bi bi-sun-fill" id="icon-sun"></i>
                    <i class="bi bi-moon-stars-fill d-none" id="icon-moon"></i>
                </button>
            </div>
        </div>
    </div>
</nav>

{% for type, messages in app.flashes %}
    {% for message in messages %}
        <div class="alert alert-{{ type == 'error' ? 'danger' : type }} alert-dismissible fade show m-3" role="alert">
            {{ message }}
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    {% endfor %}
{% endfor %}
{% block body %}{% endblock %}
<div class="container">
    <footer class="d-flex flex-wrap justify-content-between align-items-center py-3 my-4 border-top">
        <div class="col-md-4 d-flex align-items-center"><a href="/"
                                                           class="mb-3 me-2 mb-md-0 text-body-secondary text-decoration-none lh-1"
                                                           aria-label="Bootstrap">
                <svg class="bi" width="30" height="24" aria-hidden="true">
                    <use xlink:href="#bootstrap"></use>
                </svg>
            </a> <span class="mb-3 mb-md-0 text-body-secondary">© {{ 'now' | date('Y') }} <a href="https://petiar.sk">Petiar</a></span>
        </div>
        <ul class="nav col-md-6 justify-content-end align-items-center">
            {% if (app.request.locale == 'sk') %}
            <li class="nav-item"><a href="https://hribiky.cz{{ app.request.pathInfo }}" class="nav-link px-2 text-body-secondary">Česky</a></li>
            {% else %}
            <li class="nav-item"><a href="https://hribiky.sk{{ app.request.pathInfo }}" class="nav-link px-2 text-body-secondary">Slovensky</a></li>
            {% endif %}
            <li class="nav-item"><a href="{{ path('app_leaderboard') }}" class="nav-link px-2 text-body-secondary">Leaderboard</a></li>
            <li class="nav-item"><a href="{{ path('privacy') }}" class="nav-link px-2 text-body-secondary">Súkromie</a></li>
            <li class="nav-item ms-2">
                <a href="https://apps.apple.com/us/app/hr%C3%ADbiky/id6777217981" target="_blank" rel="noopener">
                    <img src="{{ asset('images/appstore/black.svg') }}" alt="Stiahni na App Store" height="32" class="appstore-badge">
                </a>
            </li>
            <li class="nav-item ms-2">
                <a href="https://www.buymeacoffee.com/petiar" target="_blank"><img src="https://cdn.buymeacoffee.com/buttons/v2/default-violet.png" alt="Buy Me a Coffee" style="height: 32px !important;width: auto !important;"></a>
            </li>
        </ul>
    </footer>
</div>
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.8/js/bootstrap.bundle.min.js"
            integrity="sha512-HvOjJrdwNpDbkGJIG2ZNqDlVqMo77qbs4Me4cah0HoDrfhrbA+8SBlZn1KrvAQw7cILLPFJvdwIgphzQmMm+Pw=="
            crossorigin="anonymous" referrerpolicy="no-referrer"></script>
    {% block mapscripts %}{% endblock %}
    <script src="{{ asset('js/photo-resize.js') }}"></script>
    <script src="{{ asset('js/hribiky.js') }}"></script>
    <script src="{{ asset('js/search-autocomplete.js') }}" defer></script>
</body>
</html>
