{% extends 'base.html.twig' %}

{% block title %}{{ 'leaderboard.title'|trans }}{% endblock %}

{% block body %}
    <div class="container py-5">
        <div class="row justify-content-center">
            <div class="col-lg-8">

                <div class="d-flex align-items-center mb-4">
                    <h1 class="h3 mb-0 me-3">{{ 'leaderboard.heading'|trans }}</h1>
                    <span class="badge bg-success">{{ 'leaderboard.subheading'|trans }}</span>
                </div>

                {% if contributors is empty %}
                    <div class="alert alert-info">
                        {{ 'leaderboard.empty'|trans }}
                    </div>
                {% else %}
                    <ul class="list-group shadow-sm">
                        {% for user in contributors %}
                            {% set rank = loop.index %}

                            <li class="list-group-item d-flex justify-content-between align-items-center">
                                <div class="d-flex align-items-center">
                                    <div class="me-3 text-center" style="min-width: 2.5rem;">
                                        {% if rank == 1 %}
                                            <span class="fs-4">🥇</span>
                                        {% elseif rank == 2 %}
                                            <span class="fs-4">🥈</span>
                                        {% elseif rank == 3 %}
                                            <span class="fs-4">🥉</span>
                                        {% else %}
                                            <span class="text-muted fw-semibold">{{ rank }}.</span>
                                        {% endif %}
                                    </div>

                                    <div>
                                        <div class="fw-semibold">
                                            {{ user.name ?: 'leaderboard.unknown_user'|trans }}
                                            {% if user.hasRole is defined and user.hasRole('ROLE_RELIABLE') %}
                                                <span class="badge bg-warning text-dark ms-2">{{ 'leaderboard.reliable'|trans }}</span>
                                            {% endif %}
                                        </div>
                                        <div class="text-muted small">
                                            {{ 'leaderboard.count'|trans({'%count%': user.mushroomCount}) }}
                                            {% if user.commentCount %}
                                                · {{ 'leaderboard.comment_count'|trans({'%count%': user.commentCount}) }}
                                            {% endif %}
                                        </div>
                                        {% set badges = badgesByUserId[user.id] ?? [] %}
                                        {% if badges is not empty %}
                                            <div class="mt-1">
                                                {% for badge in badges %}
                                                    <img src="{{ asset('images/badges/' ~ badge.type.iconSlug() ~ '.svg') }}"
                                                         alt="{{ badge.type.label }}"
                                                         title="{{ badge.type.label }}"
                                                         data-bs-toggle="tooltip"
                                                         data-bs-placement="top"
                                                         width="24" height="24" class="me-1 rounded-circle">
                                                {% endfor %}
                                            </div>
                                        {% endif %}
                                    </div>
                                </div>

                                <span class="badge bg-primary rounded-pill px-3 py-2">{{ user.score }}</span>
                            </li>
                        {% endfor %}
                    </ul>
                {% endif %}

                <div class="text-muted small mt-3">
                    <p>{{ 'leaderboard.note1'|trans }}</p>
                    <p>{{ 'leaderboard.note2'|trans }}</p>
                </div>

                {% if badgeTypes is defined and badgeTypes is not empty %}
                    <div class="mt-4">
                        <h2 class="h6 text-uppercase text-muted mb-3">{{ 'leaderboard.badges_heading'|trans }}</h2>
                        <div class="row row-cols-1 row-cols-sm-2 g-3">
                            {% for type in badgeTypes %}
                                <div class="col d-flex align-items-center gap-2">
                                    <img src="{{ asset('images/badges/' ~ type.iconSlug() ~ '.svg') }}"
                                         alt="{{ type.label }}" width="32" height="32" class="rounded-circle flex-shrink-0">
                                    <div>
                                        <div class="fw-semibold small">{{ type.label }}</div>
                                        <div class="text-muted small">{{ type.description }}</div>
                                    </div>
                                </div>
                            {% endfor %}
                        </div>
                    </div>
                {% endif %}

            </div>
        </div>
    </div>

    <script>
        document.addEventListener('DOMContentLoaded', function () {
            document.querySelectorAll('[data-bs-toggle="tooltip"]').forEach(function (el) {
                new bootstrap.Tooltip(el);
            });
        });
    </script>
{% endblock %}

