{# templates/rozcestnik/detail.html.twig #}
{% extends 'base.html.twig' %}

{% if mushroom.altitude is not empty %}
    {% set title = mushroom.title ~ ' (' ~ mushroom.altitude ~ ' m n. m.)' %}
{% else %}
    {% set title = mushroom.title %}
{% endif %}

{% block title %}{{ title }}{% endblock %}

{% block meta_description %}<meta name="description" content="{{ mushroom.description|striptags }}">{% endblock %}
{% block og_title %}{{ title }}{% endblock %}
{% block og_type %}place{% endblock %}
{% block og_description %}{{ mushroom.description|striptags }}{% endblock %}
{% block og_image %}{% if mushroom.photos is defined and mushroom.photos|length > 0 %}{{ absolute_url(asset('uploads/photos/' ~ mushroom.photos.0.path)) }}{% else %}{{ absolute_url(asset('images/android-chrome-512x512.png')) }}{% endif %}{% endblock %}

{% block ogtags %}
    <meta property="place:location:latitude" content="{{ mushroom.latitude }}">
    <meta property="place:location:longitude" content="{{ mushroom.longitude }}">
{% endblock %}

{% block body %}
    <div class="container mt-4">
        {# Rozloženie (hribiky.css → .mushroom-detail): na počítači vľavo údaje + komentáre, vpravo fotky;
           na mobile údaje → fotky → komentáre. #}
        <div class="mushroom-detail">
            <div class="md-info">
                <div class="card shadow-sm mb-4">
                    <div class="card-body">
                        <h2 class="mb-4">{{ title }}</h2>
                        <ul class="list-group list-group-flush">
                            <li class="list-group-item"><strong>{{ 'mushroom.added_by'|trans }}:</strong> {{ mushroom.name }}
                                ({{ mushroom.createdAt|date('d.m.Y H:i') }})
                            </li>

                            <li class="list-group-item"><strong>GPS:</strong>
                                <a href="{{ path('app_home', {hribik: mushroom.id}) }}" class="ms-1 me-2 text-nowrap" title="{{ 'show_on_map'|trans }}"><i class="bi bi-geo-alt-fill"></i> {{ 'show_on_map_short'|trans }}</a>
                                {% if (mushroom.country == "CZ") %}
                                    <a href="https://mapy.com/en/turisticka?x={{ mushroom.longitude }}&y={{ mushroom.latitude }}&z=14" target="_blank">{{ mushroom.latitude }}, {{ mushroom.longitude }}</a>
                                {% else %}
                                    <a href="https://mapy.dennikn.sk/?x={{ mushroom.longitude }}&y={{ mushroom.latitude }}" target="_blank">{{ mushroom.latitude }}, {{ mushroom.longitude }}</a>
                                {% endif %}
                            </li>
                            <li class="list-group-item">{{ mushroom.description|escape|nl2br }}</li>
                        </ul>
                    </div>
                </div>
                <div class="text-center mb-5">
                    {# Mapa sa vycentruje a priblíži na tento hríbik (public/js/hribiky.js → focusMushroomFromUrl). #}
                    <a href="{{ path('app_home', {hribik: mushroom.id}) }}" class="btn btn-outline-primary">
                        <i class="bi bi-geo-alt-fill"></i> {{ 'show_on_map'|trans }}
                    </a>
                </div>
            </div>

            <div class="md-side">
                {# Verejne len schválené komentáre; administrátor vidí aj čakajúce (s označením). #}
                {% set comments = mushroom.updates
                    |filter(c => c.published or is_granted('ROLE_ADMIN'))
                    |sort((a, b) => b.createdAt <=> a.createdAt) %}
                <section class="mushroom-comments mb-5" id="komentare">
                    <h4 class="mb-3">
                        {{ 'mushroom.comments_title'|trans }}
                        {% if comments|length > 0 %}<span class="badge rounded-pill text-bg-secondary align-middle fs-6">{{ comments|length }}</span>{% endif %}
                    </h4>
                    {% for comment in comments %}
                        {% set author = comment.name|default('mushroom.unknown_author'|trans) %}
                        <article class="comment d-flex mb-3">
                            <div class="comment-avatar flex-shrink-0 me-3" aria-hidden="true">{{ author|first|upper }}</div>
                            <div class="comment-bubble flex-grow-1 rounded-3 p-3">
                                <div class="d-flex flex-wrap justify-content-between align-items-baseline gap-2 mb-1">
                                    <strong>{{ author }}</strong>
                                    <time class="text-body-secondary small" datetime="{{ comment.createdAt|date('c') }}">{{ comment.createdAt|date('d.m.Y') }}</time>
                                </div>
                                {% if not comment.published %}
                                    <span class="badge text-bg-warning mb-2">{{ 'mushroom.comment_unapproved'|trans }}</span>
                                {% endif %}
                                {% if comment.description %}
                                    <p class="mb-0">{{ comment.description|e|nl2br }}</p>
                                {% endif %}
                                {% if comment.photos|length > 0 %}
                                    <div class="comment-photos d-flex flex-wrap gap-2 mt-2">
                                        {% for foto in comment.photos %}
                                            <img src="{{ asset(photo_thumb(foto.path)) }}"
                                                 class="comment-photo rounded update-foto"
                                                 alt="{{ 'mushroom.comment_photo_alt'|trans({'%name%': author}) }}"
                                                 loading="lazy"
                                                 data-bs-toggle="modal"
                                                 data-bs-target="#lightboxModal"
                                                 data-bs-src="{{ asset('uploads/photos/' ~ foto.path) }}">
                                        {% endfor %}
                                    </div>
                                {% endif %}
                            </div>
                        </article>
                    {% else %}
                        <p class="text-body-secondary">{{ 'mushroom.no_comments'|trans }}</p>
                    {% endfor %}
                </section>

                {% set visibleLinks = mushroom.articleLinks|filter(link => link.blogPost is null or link.blogPost.published) %}
                {% if visibleLinks|length > 0 %}
                    <div class="mt-5">
                        <h4 class="mb-3">Články o tomto mieste</h4>
                        <div class="list-group mb-4 shadow-sm">
                            {% for link in visibleLinks %}
                                <a href="{{ link.url }}" class="list-group-item list-group-item-action"
                                   {% if not link.blogPost %}target="_blank" rel="noopener noreferrer"{% endif %}>
                                    {{ link.title }}
                                    {% if not link.blogPost %}
                                        <span class="badge bg-secondary ms-2">externý odkaz</span>
                                    {% endif %}
                                </a>
                            {% endfor %}
                        </div>
                    </div>
                {% endif %}
            </div>

            {# Fotky: na počítači pravý stĺpec cez celú výšku, na mobile hneď pod údajmi. #}
            <div class="md-photos mb-4">
                {% if mushroom.photos|length > 0 %}
                    <div id="mushroomCarousel" class="carousel slide shadow-sm" data-bs-ride="carousel">
                        <div class="carousel-inner">
                            {% for foto in mushroom.photos %}
                                <div class="carousel-item {% if loop.first %}active{% endif %}">
                                    <img src="{{ asset('uploads/photos/' ~ foto.path) }}" class="d-block w-100 rounded"
                                         alt="Foto">
                                </div>
                            {% endfor %}
                        </div>
                        {% if mushroom.photos|length > 1 %}
                            <button class="carousel-control-prev" type="button" data-bs-target="#mushroomCarousel"
                                    data-bs-slide="prev">
                                <span class="carousel-control-prev-icon"></span>
                            </button>
                            <button class="carousel-control-next" type="button" data-bs-target="#mushroomCarousel"
                                    data-bs-slide="next">
                                <span class="carousel-control-next-icon"></span>
                            </button>
                        {% endif %}
                    </div>
                {% else %}
                    <p class="text-muted">{{ 'mushroom.no_photos'|trans }}</p>
                {% endif %}
            </div>
        </div>

    </div>
    <div class="modal fade" id="lightboxModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-lg">
            <div class="modal-content bg-transparent border-0">
                <div class="modal-body p-0 text-center">
                    <img src="" id="lightboxImage" class="img-fluid rounded" alt="Zväčšená fotka">
                </div>
            </div>
        </div>
    </div>
{% endblock %}

{% block javascripts %}
    {% set countries = {
        'SK': 'Slovakia',
        'CZ': 'Czech Republic',
        'PL': 'Poland'
    } %}
    {% set pageUrl = absolute_url(path('mushroom_detail', {'id': mushroom.id})) %}
    {% set firstPhoto = mushroom.photos|first %}
    <script type="application/ld+json">
{{ {
            "@context": "https://schema.org",
            "@type": "TouristAttraction",
            "@id": url('mushroom_detail', { id: mushroom.id}),
            "name": mushroom.title,
            "description": mushroom.description ?? "",
            "url": pageUrl,
            "mainEntityOfPage": pageUrl,
            "isAccessibleForFree": true,
            "identifier": mushroom.id,
            "geo": {
                "@type": "GeoCoordinates",
                "latitude": mushroom.latitude,
                "longitude": mushroom.longitude,
                "elevation": mushroom.altitude
            },
            "image": firstPhoto ? { "@id": pageUrl ~ "#photo-1" } : null,
            "containedInPlace": mushroom.country ? {
                "@type": "Country",
                "name": countries[mushroom.country]|default(mushroom.country)
            } : null
        } | json_encode(constant('JSON_UNESCAPED_UNICODE') b-or constant('JSON_UNESCAPED_SLASHES')) | raw }}
</script>
    <script type="application/ld+json">
{{ {
            "@context": "https://schema.org",
            "@type": "WebPage",
            "@id": pageUrl,
            "url": pageUrl,
            "datePublished": mushroom.createdAt|date('c'),
            "dateModified": (mushroom.lastModified ?? mushroom.createdAt)|date('c')
        } | json_encode(constant('JSON_UNESCAPED_UNICODE') b-or constant('JSON_UNESCAPED_SLASHES')) | raw }}
</script>
    {% if firstPhoto %}
        <script type="application/ld+json">
{{ {
                "@context": "https://schema.org",
                "@type": "ImageObject",
                "@id": pageUrl ~ "#photo-1",
                "contentUrl": absolute_url(asset('uploads/photos/' ~ firstPhoto.path)),
                "url": absolute_url(asset('uploads/photos/' ~ firstPhoto.path)),
                "dateCreated": mushroom.createdAt|date('c')
            } | json_encode(constant('JSON_UNESCAPED_UNICODE') b-or constant('JSON_UNESCAPED_SLASHES')) | raw }}
</script>
    {% endif %}
{% endblock %}
